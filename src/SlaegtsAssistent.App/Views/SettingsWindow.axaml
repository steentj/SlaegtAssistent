<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        x:Class="SlaegtsAssistent.App.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="700"
        Height="620"
        MinWidth="560"
        MinHeight="480"
        CanResize="True"
        Title="Indstillinger"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Standardmappe for GEDCOM-filer (input)" FontWeight="SemiBold" />
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DefaultGedcomInputFolder, Mode=TwoWay}" />
        <Button Grid.Row="1" Grid.Column="1" Content="Vælg…" Command="{Binding SelectGedcomInputFolderCommand}" MinWidth="90" />

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Standardmappe for Markdown-filer (output)" FontWeight="SemiBold" VerticalAlignment="Top" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,24,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding DefaultMarkdownOutputFolder, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Vælg…" Command="{Binding SelectMarkdownOutputFolderCommand}" MinWidth="90" />
        </Grid>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Global persondokumentskabelon" FontWeight="SemiBold" />
        <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding GlobalBiographyTemplatePath, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Vælg…" Command="{Binding SelectBiographyTemplateCommand}" MinWidth="90" />
        </Grid>
        <Button Grid.Row="6" Grid.ColumnSpan="2"
                Content="Nulstil til standardskabelon"
                Command="{Binding ResetBiographyTemplateCommand}"
                HorizontalAlignment="Left" />

        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Tema" FontWeight="SemiBold" />
        <ComboBox Grid.Row="8" Grid.ColumnSpan="2"
                  ItemsSource="{Binding ThemeOptions}"
                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Forhåndsvis" Command="{Binding PreviewBiographyTemplateCommand}" MinWidth="100" />
            <Button Content="Annuller" Command="{Binding CancelCommand}" MinWidth="90" />
            <Button Content="Gem" Command="{Binding SaveCommand}" MinWidth="90" />
        </StackPanel>
        <TextBlock Grid.Row="10" Grid.ColumnSpan="2"
                   Text="{Binding TemplateErrorMessage}"
                   Foreground="DarkRed"
                   TextWrapping="Wrap" />
        <TextBox Grid.Row="11" Grid.ColumnSpan="2"
                 Text="{Binding PreviewText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
