<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="SlaegtsAssistent.App.Views.TemplateCheatSheetWindow"
        x:DataType="vm:TemplateCheatSheetViewModel"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="420"
        Title="Hjælp til persondokumentskabeloner"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <TextBox x:Name="SearchBox"
                 Text="{Binding SearchText, Mode=TwoWay}"
                 automation:AutomationProperties.Name="Søg i skabelonhjælpen"
                 PlaceholderText="Søg i skabelonhjælpen…" />
        <Border Grid.Row="1"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <wv:NativeWebView x:Name="PreviewWebView"
                              automation:AutomationProperties.Name="Formateret skabelonhjælp" />
        </Border>
    </Grid>
</Window>
