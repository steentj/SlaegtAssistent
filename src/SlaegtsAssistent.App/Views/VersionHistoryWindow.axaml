<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SlaegtsAssistent.App.Views.VersionHistoryWindow"
        x:DataType="vm:VersionHistoryViewModel"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="480"
        Title="Versionshistorik">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource AppWindowBackgroundBrush}">
        <Border Grid.Row="0"
                Padding="12"
                Margin="10,10,10,4"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExtraStatusText}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Vis ændringer"
                            Command="{Binding ShowChangesCommand}"
                            IsEnabled="{Binding CanShowWorkingChanges}"
                            AutomationProperties.Name="Vis ændringer siden seneste version" />
                    <Button Content="Gem version af alle dokumenter…"
                            Command="{Binding CommitAllCommand}"
                            IsEnabled="{Binding CanCommitAll}"
                            AutomationProperties.Name="Gem version af alle dokumenter"
                            ToolTip.Tip="Gem alle åbne dokumenter og opret en version af alle dokumentændringer." />
                    <Button Content="Slå versionsstyring til"
                            Command="{Binding EnableCommand}"
                            IsVisible="{Binding ShowEnableButton}"
                            AutomationProperties.Name="Slå versionsstyring til" />
                    <Button Content="Opdatér"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Opdatér versionshistorik" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="10,0,10,4"
                Padding="8"
                Background="#33CC4455">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Margin="10,0,10,4"
                Padding="8"
                Background="#334477CC">
            <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="10,0,10,10" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="120,80,*,140,140" Margin="8,0,8,6">
                <TextBlock Grid.Column="0" Text="Dato" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Tid" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Besked" FontWeight="SemiBold" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="8,0,8,6"
                       Text="{Binding HistoryNote}" />

            <ListBox Grid.Row="2"
                     x:Name="VersionList"
                     ItemsSource="{Binding Entries}"
                     AutomationProperties.Name="Versionsliste">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionEntryViewModel">
                        <Grid ColumnDefinitions="120,80,*,140,140"
                              ColumnSpacing="8"
                              Margin="0,3">
                            <TextBlock Grid.Column="0" Text="{Binding DateText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Message}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="3"
                                    Content="Vis ændringer"
                                    Command="{Binding ShowChangesCommand}" />
                            <Button Grid.Column="4"
                                    Content="Rul tilbage her"
                                    Command="{Binding RollbackCommand}"
                                    IsVisible="{Binding IsRollbackVisible}"
                                    IsEnabled="{Binding IsRollbackEnabled}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
