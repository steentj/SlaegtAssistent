<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="560"
        x:Class="SlaegtsAssistent.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Slægtsassistent">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fil">
                <MenuItem Header="Indlæs GEDCOM fil"
                          Command="{Binding SelectGedcomFileCommand}" />
                <MenuItem Header="Gem"
                          Command="{Binding SaveAllCommand}" />
                <Separator />
                <MenuItem Header="Indstillinger"
                          Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="Afslut"
                          Command="{Binding ExitApplicationCommand}" />
            </MenuItem>
            <MenuItem Header="_Hjælp">
                <MenuItem Header="Generel introduktion"
                          Command="{Binding ShowIntroductionCommand}" />
                <MenuItem Header="Om"
                          Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Grid ColumnDefinitions="320,*" Margin="12" ColumnSpacing="12">
            <Border Grid.Column="0" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding ErrorMessage}"
                               Foreground="IndianRed"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Personer"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding PersonFilterText, Mode=TwoWay}"
                             PlaceholderText="Filtrer personer (navn eller id)"
                             Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonListItemViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl Grid.Column="1">
                <TabItem Header="Editor">
                    <Grid RowDefinitions="*,Auto" Margin="12" RowSpacing="8">
                        <TextBox Grid.Row="0"
                                 Text="{Binding Editor.MarkdownText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        <Button Grid.Row="1"
                                Content="Gem"
                                HorizontalAlignment="Right"
                                Command="{Binding SaveAllCommand}" />
                    </Grid>
                </TabItem>
                <TabItem Header="Preview">
                    <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton Content="Webvisning"
                                         GroupName="PreviewMode"
                                         IsChecked="{Binding Editor.IsWebPreviewSelected, Mode=TwoWay}" />
                            <RadioButton Content="Rå HTML"
                                         GroupName="PreviewMode"
                                         IsChecked="{Binding Editor.IsHtmlPreviewSelected, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <wv:NativeWebView Source="{Binding Editor.PreviewWebUri}"
                                              IsVisible="{Binding Editor.IsWebPreviewSelected}" />
                            <TextBox IsVisible="{Binding Editor.IsHtmlPreviewSelected}"
                                     IsReadOnly="True"
                                     Text="{Binding Editor.PreviewHtml}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
