<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        xmlns:views="using:SlaegtsAssistent.App.Views"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1220"
        d:DesignHeight="760"
        x:Class="SlaegtsAssistent.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Slægtsassistent"
        Width="1220"
        Height="760"
        MinWidth="960"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppWindowBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="SLÆGTSASSISTENT"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AppAccentMutedBrush}"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="ARBEJDSBORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Menu x:Name="WindowMenu" />
                    <Button Content="Indlæs GEDCOM"
                            Command="{Binding SelectGedcomFileCommand}" />
                    <Button Content="Annullér handling"
                            Command="{Binding CancelImportCommand}"
                            IsVisible="{Binding IsImporting}" />
                    <Button Content="Gem alle"
                            Command="{Binding SaveAllCommand}"
                            ToolTip.Tip="Gem ændringer i alle åbne dokumenter uden at oprette en version." />
                    <Button Content="Gem version…"
                            Command="{Binding CommitCommand}"
                            ToolTip.Tip="Gem alle åbne dokumenter og opret en version af alle dokumentændringer." />
                    <Button x:Name="ContextToggle" Content="Skjul kontekst" Click="ToggleContext" />
                </WrapPanel>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasImportStatus}">
                <TextBlock Text="{Binding ImportPhaseText}"
                           VerticalAlignment="Center" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ImportProgressPercent}"
                             Width="180"
                             Height="8"
                             VerticalAlignment="Center" />
            </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="260,8,*,8,260" Margin="12">
            <Border Grid.Column="0"
                    MinWidth="220" Margin="0,0,4,0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <TextBlock Text="PERSONER"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                        <TextBox Text="{Binding PersonFilterText, Mode=TwoWay}"
                                 PlaceholderText="Søg navn eller record-id" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox x:Name="PeopleList" ItemsSource="{Binding People}"
                             SelectedItem="{Binding SelectedPerson}" KeyDown="PeopleListKeyDown"
                             AutomationProperties.Name="Personer"
                             Margin="0,12,0,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonListItemViewModel">
                                <Border Padding="6,3"
                                        Margin="0,0,0,1"
                                        Background="{DynamicResource AppPanelMutedBrush}"
                                        CornerRadius="4"
                                        ToolTip.Tip="{Binding ToolTipText}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RecordId}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SyncStatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppAccentBrush}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding StatusNoticeText}"
                                                   IsVisible="{Binding HasStatusNotice}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppDangerBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource AppBorderBrush}" ResizeDirection="Columns"
                          AutomationProperties.Name="Tilpas personlistens bredde" />

            <Border Grid.Column="2" Margin="4,0"
                    MinWidth="420"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="2" IsVisible="{Binding IsBiographyTab}">
                            <TextBlock Text="{Binding ActivePersonText}"
                                       FontSize="18"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ActiveMarkdownFilePathText}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding SelectedPerson.MarkdownFilePath}"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="2" IsVisible="{Binding IsGraphTab}">
                            <TextBlock Text="{Binding PersonGraph.ProbandText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1" SelectedIndex="{Binding DocumentTabIndex, Mode=TwoWay}">
                        <TabItem x:Name="GraphTab" Header="Graf">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" IsEnabled="{Binding !IsImporting}">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Opdatér graf" Command="{Binding RefreshGraphCommand}" />
                                    <Button Content="Brug som proband" Command="{Binding PersonGraph.UseAsProbandCommand}" />
                                    <Button Content="Åbn biografi" Command="{Binding PersonGraph.OpenBiographyCommand}" />
                                </WrapPanel>
                                <Grid Grid.Row="1" ColumnDefinitions="*,200" ColumnSpacing="8">
                                    <Grid RowDefinitions="Auto,Auto,*">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="+" Click="GraphZoomIn" ToolTip.Tip="Zoom ind" />
                                            <Button Content="−" Click="GraphZoomOut" ToolTip.Tip="Zoom ud" />
                                            <Button Content="Vis alle" Click="GraphShowAll" />
                                            <Button Content="Centrér proband" Click="GraphCenterProband" />
                                        </WrapPanel>
                                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6">
                                            <Button Content="Eksportér graf…" Click="ShowGraphExport" />
                                            <Button Content="Udskriv…" Click="ShowGraphPrint" />
                                            <Button x:Name="CancelGraphExport" Content="Annullér eksport" Click="GraphCancelExport" IsEnabled="False" />
                                        </WrapPanel>
                                        <views:PersonGraphControl x:Name="GraphControl" Grid.Row="2" DataContext="{Binding PersonGraph}"
                                            AutomationProperties.Name="Personnetværk"
                                            AutomationProperties.HelpText="Brug piletaster til panorering, plus og minus til zoom og Home til at vise alle. Vælg personer i listen." />
                                    </Grid>
                                    <ScrollViewer Grid.Column="1" AutomationProperties.Name="Person og direkte forbindelser">
                                        <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding PersonGraph.ConnectionSummary}" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <ItemsControl ItemsSource="{Binding PersonGraph.DirectConnections}">
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GraphPersonItemViewModel"><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                                <StackPanel Grid.Row="2" Spacing="2">
                                    <TextBlock Text="Klik i grafen eller vælg graffanen med tastaturet. Piletaster: panorér. Plus/minus: zoom. Home: vis alle. Enter i personlisten åbner biografien."
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PersonGraph.Status}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Editor">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <StackPanel Spacing="8">
                                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding CanEditImages}">
                                    <Button Content="Vælg eller skift topbillede…" Click="ChoosePortraitClick" />
                                    <Button Content="Fjern topbillede" Click="RemovePortraitClick" />
                                    <Button Content="Indsæt billede…" Click="InsertBiographyImageClick" />
                                </WrapPanel>
                                <StackPanel IsVisible="{Binding Editor.HasPersonLinks}" Spacing="4">
                                    <TextBlock Text="Gå til person" FontWeight="SemiBold" />
                                    <ScrollViewer MaxHeight="100" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Editor.PersonLinks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PersonNavigationItem">
                                                    <Button Content="{Binding Label}" Command="{Binding OpenCommand}"
                                                            ToolTip.Tip="{Binding ToolTip}" Margin="0,0,6,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                </StackPanel>
                            <TextBox x:Name="BiographyEditor" Grid.Row="1" Text="{Binding Editor.MarkdownText, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="12"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Preview">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton Content="Webvisning"
                                                 GroupName="PreviewMode"
                                                 IsChecked="{Binding Editor.IsWebPreviewSelected, Mode=TwoWay}" />
                                    <RadioButton Content="Rå HTML"
                                                 GroupName="PreviewMode"
                                                 IsChecked="{Binding Editor.IsHtmlPreviewSelected, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Editor.PreviewSecurityMessage}"
                                           IsVisible="{Binding Editor.HasPreviewSecurityMessage}"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="2">
                                    <wv:NativeWebView x:Name="PreviewWebView"
                                                      IsVisible="{Binding Editor.IsWebPreviewSelected}" />
                                    <TextBox IsVisible="{Binding Editor.IsHtmlPreviewSelected}"
                                             IsReadOnly="True"
                                             Text="{Binding Editor.PreviewHtml}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <TextBlock Grid.Row="2" IsVisible="{Binding IsBiographyTab}"
                               Text="Fri tekst ændres aldrig automatisk af GEDCOM."
                               FontSize="11"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border x:Name="ContextPanel" Grid.Column="4"
                    MinWidth="260"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="KONTEKST"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                            <TextBlock Text="Dokument og GEDCOM holdes adskilt, så ændringer kan gennemgås sikkert."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                        </StackPanel>

                        <Expander Header="Rå GEDCOM-data">
                            <TextBox Text="{Binding SelectedPerson.RawGedcom}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="180"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Expander>

                        <Expander Header="Importrapport"
                                  IsVisible="{Binding HasImportDiagnostics}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ImportSummaryText}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding DiagnosticSeverityFilters}"
                                          SelectedItem="{Binding SelectedDiagnosticSeverityFilter}" />
                                <ListBox ItemsSource="{Binding ImportDiagnostics}"
                                         SelectedItem="{Binding SelectedImportDiagnostic}"
                                         MaxHeight="280">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GedcomDiagnosticViewModel">
                                            <StackPanel Spacing="2" Margin="4">
                                                <TextBlock Text="{Binding SeverityText}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AppDangerBrush}" />
                                                <TextBlock Text="{Binding LocationText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Consequence}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                                <TextBlock Text="{Binding FilePath}"
                                                           TextWrapping="Wrap"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Filer">
                            <StackPanel Spacing="8">
                                <TextBlock Text="GEDCOM-fil" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveFilePathText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock Text="Redigeringsfil" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveMarkdownFilePathText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding SaveStatusText}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SaveStatusText}"
                           Foreground="{DynamicResource AppAccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ActivePersonText}" IsVisible="{Binding IsBiographyTab}" Foreground="{DynamicResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ActivePersonText}" />
                <TextBlock Grid.Column="1" Text="{Binding PersonGraph.ProbandText}" IsVisible="{Binding IsGraphTab}" Foreground="{DynamicResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PersonGraph.ProbandText}" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveFilePathText}" Foreground="{DynamicResource AppMutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedGedcomFilePath}" />
                <TextBlock Grid.Column="3" Text="Lokal behandling" Foreground="{DynamicResource AppMutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
