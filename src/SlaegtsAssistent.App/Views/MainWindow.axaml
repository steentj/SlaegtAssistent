<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SlaegtsAssistent.App.ViewModels"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1220"
        d:DesignHeight="760"
        x:Class="SlaegtsAssistent.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Slægtsassistent"
        Width="1220"
        Height="760"
        MinWidth="960"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppWindowBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="SLÆGTSASSISTENT"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AppAccentMutedBrush}"
                            CornerRadius="4"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="ARBEJDSBORD"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Menu>
                        <MenuItem Header="_Hjælp">
                            <MenuItem Header="Introduktion"
                                      Command="{Binding ShowIntroductionCommand}" />
                            <MenuItem Header="Om"
                                      Command="{Binding ShowAboutCommand}" />
                            <Separator />
                            <MenuItem Header="Markdown-cheat sheet"
                                      Command="{Binding ShowMarkdownCheatSheetCommand}" />
                        </MenuItem>
                    </Menu>
                    <Button Content="Indlæs GEDCOM"
                            Command="{Binding SelectGedcomFileCommand}" />
                    <Button Content="Gem"
                            Command="{Binding SaveAllCommand}" />
                    <Button Content="Indstillinger"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*,320" ColumnSpacing="12" Margin="12">
            <Border Grid.Column="0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <TextBlock Text="PERSONER"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                        <TextBox Text="{Binding PersonFilterText, Mode=TwoWay}"
                                 PlaceholderText="Søg navn eller record-id" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding People}"
                             SelectedItem="{Binding SelectedPerson}"
                             Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersonListItemViewModel">
                                <Border Padding="8,7"
                                        Margin="0,0,0,4"
                                        Background="{DynamicResource AppPanelMutedBrush}"
                                        CornerRadius="4"
                                        ToolTip.Tip="{Binding RawGedcom}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RecordId}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppMutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding ActivePersonText}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ActiveMarkdownFilePathText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Gem ændringer"
                                Command="{Binding SaveAllCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Editor">
                            <TextBox Text="{Binding Editor.MarkdownText, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Padding="12"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Preview">
                            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton Content="Webvisning"
                                                 GroupName="PreviewMode"
                                                 IsChecked="{Binding Editor.IsWebPreviewSelected, Mode=TwoWay}" />
                                    <RadioButton Content="Rå HTML"
                                                 GroupName="PreviewMode"
                                                 IsChecked="{Binding Editor.IsHtmlPreviewSelected, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <wv:NativeWebView x:Name="PreviewWebView"
                                                      IsVisible="{Binding Editor.IsWebPreviewSelected}" />
                                    <TextBox IsVisible="{Binding Editor.IsHtmlPreviewSelected}"
                                             IsReadOnly="True"
                                             Text="{Binding Editor.PreviewHtml}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <TextBlock Grid.Row="2"
                               Text="Fri tekst ændres aldrig automatisk af GEDCOM."
                               FontSize="11"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="KONTEXT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                            <TextBlock Text="Dokument og GEDCOM holdes adskilt, så ændringer kan gennemgås sikkert."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppMutedTextBrush}" />
                        </StackPanel>

                        <Expander Header="Rå GEDCOM-data">
                            <TextBox Text="{Binding SelectedPerson.RawGedcom}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="180"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Expander>

                        <Expander Header="Filer">
                            <StackPanel Spacing="8">
                                <TextBlock Text="GEDCOM-fil" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveFilePathText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                                <TextBlock Text="Redigeringsfil" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveMarkdownFilePathText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18">
                <TextBlock Text="{Binding SaveStatusText}"
                           Foreground="{DynamicResource AppAccentBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ActivePersonText}" Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding ActiveFilePathText}" Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBlock Grid.Column="3" Text="Lokal behandling" Foreground="{DynamicResource AppMutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
