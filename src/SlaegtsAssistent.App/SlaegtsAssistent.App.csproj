<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIkon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DistributionBuild)' == 'true'">
    <RuntimeIdentifiers>osx-arm64;win-x64;linux-x64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.distribution.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\Miscellaenous\AppIkon.png" Link="Assets\AppIkon.png" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64')">
    <Content Include="..\..\tools\graphviz\osx-arm64\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RestoreLocalWindowsExportTools" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and !Exists('$(MSBuildProjectDirectory)/../../tools/export/win-x64/slaegt-export/slaegt-export.exe') and Exists('$(MSBuildProjectDirectory)/../../vendor/eksport/win-x64/eksportvaerktoej.tar.gz')">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../../scripts/genskab-eksportvaerktoej-windows.py&quot;" />
  </Target>
  <Target Name="CopyLocalWindowsExportTools" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and Exists('$(MSBuildProjectDirectory)/../../tools/export/win-x64/slaegt-export/slaegt-export.exe')">
    <ItemGroup><WindowsExportFiles Include="$(MSBuildProjectDirectory)/../../tools/export/win-x64/slaegt-export/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WindowsExportFiles)" DestinationFiles="@(WindowsExportFiles->'$(TargetDir)tools/export/slaegt-export/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishLocalWindowsExportTools" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' == 'win-x64' and Exists('$(MSBuildProjectDirectory)/../../tools/export/win-x64/slaegt-export/slaegt-export.exe')">
    <ItemGroup><WindowsPublishExportFiles Include="$(MSBuildProjectDirectory)/../../tools/export/win-x64/slaegt-export/**/*" /></ItemGroup>
    <Copy SourceFiles="@(WindowsPublishExportFiles)" DestinationFiles="@(WindowsPublishExportFiles->'$(PublishDir)tools/export/slaegt-export/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RestoreLocalLinuxExportTools" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64') and !Exists('$(MSBuildProjectDirectory)/../../tools/export/linux-x64/slaegt-export/slaegt-export') and Exists('$(MSBuildProjectDirectory)/../../vendor/eksport/linux-x64/eksportvaerktoej.tar.gz')">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../scripts/genskab-eksportvaerktoej-linux.py&quot;" />
  </Target>
  <Target Name="CopyLocalLinuxExportTools" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'linux-x64') and Exists('$(MSBuildProjectDirectory)/../../tools/export/linux-x64/slaegt-export/slaegt-export')">
    <MakeDir Directories="$(TargetDir)tools/export/slaegt-export" />
    <Exec Command="cp -a &quot;$(MSBuildProjectDirectory)/../../tools/export/linux-x64/slaegt-export/.&quot; &quot;$(TargetDir)tools/export/slaegt-export/&quot;" />
  </Target>
  <Target Name="PublishLocalLinuxExportTools" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(MSBuildProjectDirectory)/../../tools/export/linux-x64/slaegt-export/slaegt-export')">
    <MakeDir Directories="$(PublishDir)tools/export/slaegt-export" />
    <Exec Command="cp -a &quot;$(MSBuildProjectDirectory)/../../tools/export/linux-x64/slaegt-export/.&quot; &quot;$(PublishDir)tools/export/slaegt-export/&quot;" />
  </Target>

  <Target Name="RestoreLocalMacExportTools" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64') and !Exists('$(MSBuildProjectDirectory)/../../tools/export/osx-arm64/slaegt-export/slaegt-export') and Exists('$(MSBuildProjectDirectory)/../../vendor/eksport/osx-arm64/pdf-vaerktoej.tar.gz')">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../scripts/genskab-pdfvaerktoej-macos.py&quot;" />
  </Target>

  <Target Name="RestoreLocalMacGraphviz" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64') and !Exists('$(MSBuildProjectDirectory)/../../tools/graphviz/osx-arm64/sfdp') and Exists('$(MSBuildProjectDirectory)/../../vendor/graphviz/osx-arm64/graphviz.tar.gz')">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../scripts/genskab-graphviz-macos.py&quot;" />
  </Target>

  <Target Name="CopyRestoredMacGraphviz" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64') and Exists('$(MSBuildProjectDirectory)/../../tools/graphviz/osx-arm64/sfdp')">
    <Exec Command="/usr/bin/ditto &quot;$(MSBuildProjectDirectory)/../../tools/graphviz/osx-arm64&quot; &quot;$(TargetDir)tools&quot;" />
  </Target>

  <Target Name="PublishRestoredMacGraphviz" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RuntimeIdentifier)' == 'osx-arm64' and Exists('$(MSBuildProjectDirectory)/../../tools/graphviz/osx-arm64/sfdp')">
    <Exec Command="/usr/bin/ditto &quot;$(MSBuildProjectDirectory)/../../tools/graphviz/osx-arm64&quot; &quot;$(PublishDir)tools&quot;" />
  </Target>

  <Target Name="CopyLocalMacExportTools" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'osx-arm64') and Exists('$(MSBuildProjectDirectory)/../../tools/export/osx-arm64/slaegt-export/slaegt-export')">
    <Exec Command="/usr/bin/ditto &quot;$(MSBuildProjectDirectory)/../../tools/export/osx-arm64/slaegt-export&quot; &quot;$(TargetDir)tools/export/slaegt-export&quot;" />
  </Target>

  <Target Name="PublishLocalMacExportTools" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RuntimeIdentifier)' == 'osx-arm64' and Exists('$(MSBuildProjectDirectory)/../../tools/export/osx-arm64/slaegt-export/slaegt-export')">
    <Exec Command="/usr/bin/ditto &quot;$(MSBuildProjectDirectory)/../../tools/export/osx-arm64/slaegt-export&quot; &quot;$(PublishDir)tools/export/slaegt-export&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SlaegtsAssistent.Core\SlaegtsAssistent.Core.csproj" />
  </ItemGroup>
</Project>
